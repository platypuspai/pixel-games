const db = firebase.database();

const playerName = localStorage.getItem('pg_player_name') || 'Player';
const accountCode = localStorage.getItem('pg_account_code') || '';
document.getElementById('player-name').textContent = playerName.toUpperCase();

let totalSeconds = parseInt(localStorage.getItem('time_ticker_seconds')) || 0;

const factDefs = [
    { id: 'btc', icon: '🪙', animHtml: '<div class="anim-btc-hyper">฿</div>', title: 'Bitcoin Value', desc: 'Worth of 1 BTC bought at $0.0009 rate back in 2009.', calc: s => '$' + (60000 + (s * 0.05)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) },
    { id: 'brain_power', icon: '⚡', animHtml: '<div class="anim-brain-normal">🧠</div>', title: 'Brain Power', desc: 'Bio-electrical energy produced continuously by your brain (20W).', calc: s => (s * 20 < 1000) ? (s * 20) + ' Joules' : ((s * 20) / 1000).toFixed(2) + ' kJ' },
    { id: 'lego', icon: '🧱', animHtml: '<div class="anim-lego-hyper"><div class="lego-sketch ls-1"></div><div class="lego-sketch ls-2"></div></div>', title: 'Lego Spire', desc: 'Height of a tower built by stacking 1 brick every single second.', calc: s => (s * 0.0096 < 1000) ? (s * 0.0096).toFixed(2) + ' m' : ((s * 0.0096) / 1000).toFixed(3) + ' km' },
    { id: 'pizza_slices', icon: '🍕', animHtml: '<div class="anim-pizza-mega">🍕<div class="bite-mark bite-1"></div></div>', title: 'Pizza Slices', desc: 'Slices eaten worldwide (~350/s) & total weight in kilograms.', calc: s => { const sl = Math.floor(s * 350); return sl.toLocaleString('en-US') + ' slices (' + Math.floor(sl * 0.107).toLocaleString('en-US') + ' kg)'; } },
    { id: 'hair_growth', icon: '💇', animHtml: '<div class="anim-hair-hyper"><div class="avatar-hair-cap"></div><div class="avatar-hair-flow"></div><div class="avatar-head"></div></div>', title: 'Hair Growth', desc: 'Combined length grown across all 8 billion people on Earth.', calc: s => Math.floor(s * 12000).toLocaleString('en-US') + ' km' },
    { id: 'youtube_watchtime', icon: '📺', animHtml: '<div class="anim-yt-mega"><div class="yt-icon yt-1"></div><div class="yt-icon yt-2"></div></div>', title: 'YouTube Streamed', desc: 'Combined years of video watched by humanity continuously.', calc: s => ((s * 11574) / 365.25).toFixed(2) + ' video yrs' },
    { id: 'sun_energy', icon: '☀️', animHtml: '<div class="anim-sun-mega">☀️</div>', title: 'Sun Energy', desc: 'Energy radiated into deep space by the Sun in Megatons TNT.', calc: s => Math.floor(s * 91000000000).toLocaleString('en-US') + ' MT' },
    { id: 'sneezes', icon: '🤧', animHtml: '<div class="anim-sneezes-three"><span class="sneeze-item sn-1">🤧</span><span class="sneeze-item sn-2">🤧</span><span class="sneeze-item sn-3">🤧</span></div>', title: 'Global Sneezes', desc: 'Human sneezes happening across the world population.', calc: s => Math.floor(s * 9300).toLocaleString('en-US') },
    { id: 'ants', icon: '🐜', animHtml: '<div class="anim-ants-march"><div class="ant-runner ant-1">🐜</div><div class="ant-runner ant-2">🐜</div></div>', title: 'Ants Born', desc: 'New ant eggs hatching around the globe right now.', calc: s => Math.floor(s * 3200000).toLocaleString('en-US') },
    { id: 'coffee_cups', icon: '☕', animHtml: '<div class="anim-coffee-mega">☕<div class="steam-line s1"></div><div class="steam-line s2"></div></div>', title: 'Coffee Cups', desc: 'Cups of coffee freshly consumed worldwide.', calc: s => Math.floor(s * 25000).toLocaleString('en-US') + ' cups' },
    { id: 'olympic_tears', icon: '💧', animHtml: '<div class="anim-drops-emojis"><span class="drop-emoji de-1">💧</span><span class="drop-emoji de-2">💧</span><span class="drop-emoji de-3">💧</span></div>', title: 'Tear Pool Fill', desc: 'Olympic pools filled if every human cried 1 tear per second.', calc: s => (s * 0.16).toFixed(2) + ' pools' },
    { id: 'boba_straw', icon: '🧋', animHtml: '<div class="anim-straws-detail"><div class="straw-body st-1"></div><div class="straw-body st-2"></div><div class="straw-body st-3"></div></div>', title: 'Infinite Straw', desc: 'Length of a pipe made by joining all Bubble Tea straws used globally.', calc: s => (s * 125 < 1000) ? Math.floor(s * 125).toLocaleString('en-US') + ' m' : ((s * 125) / 1000).toFixed(2) + ' km' },
    { id: 'toilet_paper_moon', icon: '🧻', animHtml: '<div class="anim-tp-upright-stack"><div class="tp-upright-roll tpu-top"></div><div class="tp-upright-roll"></div></div>', title: 'Paper to Moon', desc: '% of distance to Moon reached by unrolling 1 toilet paper roll/sec.', calc: s => (((s * 0.00005 / 384400) * 100)).toFixed(6) + ' %' },
    { id: 'avocado_toast', icon: '🥑', animHtml: '<div class="anim-sandwich-build"><div class="bread-top"></div><div class="avocado-layer"></div><div class="bread-bottom"></div></div>', title: 'Avocado Toast', desc: 'Avocado toasts prepared globally and total money spent ($8 each).', calc: s => { const t = Math.floor(s * 120); return t.toLocaleString('en-US') + ' ($' + (t * 8).toLocaleString('en-US') + ')'; } },
    { id: 'cat_purrs', icon: '🐱', animHtml: '<div class="anim-cat-sleeping">
