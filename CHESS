// VERVANG DEZE GEGEVENS MET JOUW EIGEN FIREBASE PROJECT DETAILS!
const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT_://firebaseapp.com",
    databaseURL: "https://YOUR_PROJECT_://firebaseio.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT_://appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
};

// Initialiseer Firebase (v9 compat SDK vereist in je HTML)
if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
}
const database = firebase.database();

// ==========================================
// 2. GLOBALE AI VARIABELEN
// ==========================================
let moveHistory = []; // Slaat de stellingen en zetten van het huidige potje op

// ==========================================
// 3. KERN AI LOGICA (ZET BEREKENEN & LEREN)
// ==========================================

/**
 * Berekent de beste zet voor de AI op basis van collectieve ervaring in Firebase.
 * @param {Chess} gameInstance - De huidige instantie van het chess.js object
 * @returns {Promise<Object>} De gekozen legale zet (verbose move object van chess.js)
 */
async function computeAIMove(gameInstance) {
    const moves = gameInstance.moves({ verbose: true });
    if (moves.length === 0) return null;

    // Converteer FEN naar een geldige Firebase-sleutel (slashes vervangen door underscores)
    const currentFen = gameInstance.fen().replace(/\//g, "_");

    // Haal de opgeslagen zet-statistieken op uit de wereldwijde Firebase database
    let learnedMoves = {};
    try {
        const snapshot = await database.ref('positions/' + currentFen).once('value');
        if (snapshot.exists()) {
            learnedMoves = snapshot.val();
        }
    } catch (error) {
        console.error("Fout bij ophalen Firebase data:", error);
    }

    let bestMove = null;
    let maxScore = -Infinity;

    // Evalueer elke legale zet
    moves.forEach(move => {
        const moveSan = move.san;
        // Haal de score op uit de database (standaard 0 als de AI deze zet hier nooit heeft gedaan)
        const score = learnedMoves[moveSan] || 0;

        // Exploratie-factor (epsilon): Voeg een minieme hoeveelheid willekeur toe.
        // Dit zorgt ervoor dat de AI openstaat voor het ontdekken van nieuwe, betere zetten.
        const explorationScore = score + (Math.random() * 0.1);

        if (explorationScore > maxScore) {
            maxScore = explorationScore;
            bestMove = move;
        }
    });

    // Sla deze specifieke stelling en de gekozen zet op in het geheugen van dit actuele potje
    moveHistory.push({
        fen: currentFen,
        move: bestMove.san
    });

    return bestMove;
}

/**
 * Verwerkt de uitkomst van het spel en past de scores van de AI-zetten aan in Firebase.
 * @param {string} winner - De winnaar van het potje ('AI', 'PLAYER', of 'DRAW')
 */
function trainAIOnGameEnd(winner) {
    if (moveHistory.length === 0) return;

    // Bepaal de beloning op basis van winst of verlies
    let reward = 0;
    if (winner === 'AI') {
        reward = 1;   // AI wint -> Beloon alle uitgevoerde zetten van dit potje
    } else if (winner === 'PLAYER') {
        reward = -1;  // AI verliest -> Bestraf alle uitgevoerde zetten van dit potje
    } else if (winner === 'DRAW') {
        reward = 0.1; // Remise -> Lichte positieve prikkel (beter dan verliezen)
    }

    // Update elke zet uit de geschiedenis van dit potje in de cloud database
    moveHistory.forEach(historyItem => {
        const moveRef = database.ref('positions/' + historyItem.fen + '/' + historyItem.move);
        
        // Gebruik een transactie om data-overschrijvingen door gelijktijdige internetspelers te voorkomen
        moveRef.transaction((currentScore) => {
            return (currentScore || 0) + reward;
        });
    });

    // Wis de geschiedenis zodat de AI klaar is voor een nieuw potje
    clearAIMemory();
}

/**
 * Reset de zetgeschiedenis van de AI voor een nieuw spel.
 */
function clearAIMemory() {
    moveHistory = [];
}

// Exporteer functies naar het globale venster zodat je index.js/html erbij kan
window.ChessAI = {
    computeMove: computeAIMove,
    processResult: trainAIOnGameEnd,
    reset: clearAIMemory
};
